{
  "name": "etubu",
  "version": "1.0.0",
  "private": true,
  "description": "ETUBU — EV/Tesla driving cluster, dashboard and drive-sound companion app.",
  "scripts": {
    "sync": "cap sync ios",
    "open:ios": "cap open ios",
    "build:ios": "xcodebuild -workspace ios/App/App.xcworkspace -scheme Etubu -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "test:maestro": "export PATH=\"/opt/homebrew/opt/openjdk@17/bin:$HOME/.maestro/bin:$PATH\" JAVA_HOME=\"/opt/homebrew/opt/openjdk@17\" && maestro test --device 'iPhone 17 Pro' .maestro/smoke-onboarding.yaml .maestro/demo-stop-sound-check.yaml .maestro/demo-drive-check.yaml .maestro/ev-plan-demo-check.yaml",
    "test:maestro:sound": "export PATH=\"/opt/homebrew/opt/openjdk@17/bin:$HOME/.maestro/bin:$PATH\" JAVA_HOME=\"/opt/homebrew/opt/openjdk@17\" && maestro test --device 'iPhone 17 Pro' .maestro/demo-stop-sound-check.yaml"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  }
}
